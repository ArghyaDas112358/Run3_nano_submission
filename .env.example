# =================================================================
# Personal harness configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# =================================================================

# --- Grid usernames ---------------------------------------------------
# Your username at each grid site (they are typically different).
# Used in CRAB output LFNs, EOS paths, and documentation strings.
PURDUE_USER=your_purdue_username
FNAL_USER=your_fnal_username
CERN_USER=your_cern_username

# --- CMSSW build area -------------------------------------------------
# Absolute path to your CMSSW area.
# Option A (recommended for new users):
#   Run ./setup.sh inside this harness; the build lands at
#   ./cmssw/CMSSW_16_0_1, and you set:
#     CMSSW_AREA=/absolute/path/to/this/harness/cmssw/CMSSW_16_0_1
# Option B:
#   Point to a pre-existing build elsewhere.
CMSSW_AREA=/absolute/path/to/your/CMSSW_16_0_1
CMSSW_VERSION=CMSSW_16_0_1

# --- Tier-2 storage site for CRAB output ------------------------------
# Examples: T2_US_Purdue / T1_US_FNAL_Disk / T2_CH_CERN
# Non-Purdue users should also pass --card cards/<site>.yaml to crabby.py
# so the cmsRun config and lumi mask routing pick up the override.
STORAGE_SITE=T2_US_Purdue

# --- Production campaign tag ------------------------------------------
# Used in TAG, crab workArea, and outLFNDirBase.
# Override per submission with crabby.py --campain X
CAMPAIGN=NanoAODv15Scouting24
