# =================================================================
# Personal harness configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# =================================================================

# --- Grid usernames ---------------------------------------------------
# Your username at each grid site (they are typically different).
# Used in CRAB output LFNs, EOS paths, and documentation strings.
PURDUE_USER=your_purdue_username
FNAL_USER=your_fnal_username
CERN_USER=your_cern_username

# --- CMSSW build area -------------------------------------------------
# Absolute path to your CMSSW area.
# Option A (recommended for new users):
#   Run ./setup.sh inside this harness; the build lands at
#   ./cmssw/CMSSW_16_1_0_pre4, and you set:
#     CMSSW_AREA=/absolute/path/to/this/harness/cmssw/CMSSW_16_1_0_pre4
# Option B:
#   Point to a pre-existing build elsewhere.
CMSSW_AREA=/absolute/path/to/this/harness/cmssw/CMSSW_16_1_0_pre4
CMSSW_VERSION=CMSSW_16_1_0_pre4

# --- Tier-2 storage site for CRAB output ------------------------------
# Set this to a site where YOUR grid identity has a /store/user area
# (CRAB can only stage out to your own area). Purdue users: T2_US_Purdue.
# Non-Purdue users: your institute T2 / T3, e.g. T2_DE_DESY, T3_CH_CERNBOX.
# (Purdue DN-mapping for externals is being requested — until then use your
# own site; outputs get aggregated to Purdue afterwards, see RUNBOOK_CHS.md)
STORAGE_SITE=T2_US_Purdue

# --- Production campaign tag ------------------------------------------
# Used in TAG, crab workArea, and outLFNDirBase.
# Override per submission with crabby.py --campaign X.
# (Legacy spelling --campain still works but prints a deprecation warning.)
CAMPAIGN=NanoAODv17ScoutingCHS24
